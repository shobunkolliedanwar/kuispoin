GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SERVER ONLY. Jangan gunakan key ini di komponen client dan jangan commit .env.local.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Integration/concurrency tests mutate data. Enable ONLY on a DEV/TEST Supabase project.
# Keep false/absent for production.
ALLOW_MONEY_SAFETY_TESTS="false"

# Rewarded ads: DISABLED (default) or DEMO for staging smoke tests.
# Production provider integration will replace DEMO with a verified provider adapter/webhook.
REWARDED_AD_PROVIDER=DISABLED

# Google AdSense (publisher/client ID is public, not a secret).
# Set enabled=false locally if you do not want the AdSense script loaded in a production-mode local build.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-3192016222321677"
NEXT_PUBLIC_ADSENSE_ENABLED="true"
